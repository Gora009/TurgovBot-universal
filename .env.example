# =============================================================================
# TurgovBot — Шаблон переменных окружения
# Скопируйте этот файл: cp .env.example .env
# И заполните значениями
# =============================================================================

# --- База данных PostgreSQL ---
DB_USER=bot_db_user
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432
DB_NAME=bot_database

# --- Telegram ---
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# =============================================================================
# --- Языковые модели (любой OpenAI-совместимый API) ---
# Подробно: docs/LLM_PROVIDERS.md
#
# Минимум — три строки. Остальные роли возьмут этот же ключ и адрес.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-...
LLM_SMART_MODEL=deepseek-chat
#
# Роли (у каждой может быть свой поставщик: LLM_<РОЛЬ>_BASE_URL / _API_KEY / _MODEL):
#   FAST   — роутеры законов, оптимизатор вопроса, сводки (по умолчанию = SMART)
#   SMART  — ответы, ролевой помощник, документы, анализ жалоб
#   VISION — картинки: OCR паспорта, скриншоты из дел (по умолчанию = SMART;
#            DeepSeek картинки НЕ принимает — задайте другую модель)
#   EMBED  — векторы для RAG (/embeddings); без неё не работают советы оверлея и Q&A v2
#   STT    — распознавание голоса (/audio/transcriptions); без неё голос выключен
LLM_FAST_MODEL=
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=
LLM_EMBED_BASE_URL=
LLM_EMBED_API_KEY=
LLM_EMBED_MODEL=
LLM_STT_BASE_URL=
LLM_STT_API_KEY=
LLM_STT_MODEL=
#
# Тонкая настройка (необязательно):
# LLM_MAX_INPUT_CHARS=300000      # потолок входа (законы+вопрос); уменьшить для моделей с окном < 128K; 0 = без лимита
# LLM_TIMEOUT_SECONDS=180
# LLM_JSON_MODE=json_object       # json_object | json_schema | prompt (для API без response_format)
# LLM_SEND_REASONING_EFFORT=false # true — передавать уровень «размышлений» как reasoning_effort (OpenAI o-серия, gpt-5)
# LLM_EMBED_SEND_DIMENSIONS=false # true — передавать dimensions (text-embedding-3-*)
# LLM_SMART_QPM=50                # лимит запросов в минуту на роль (FAST/SMART/VISION/EMBED)
# LLM_HTTP_REFERER=https://your.site   # для OpenRouter
# LLM_APP_TITLE=TurgovBot              # для OpenRouter
# =============================================================================

# --- Хранилище файлов (законы, документы дел, пруфы) ---
# Файлы лежат локально; ссылки на скачивание идут через API: PUBLIC_BASE_URL/files/...
STORAGE_DIR=/app/data/storage
PUBLIC_BASE_URL=https://api.your-domain.com
# Секрет подписи ссылок (по умолчанию берётся DEVICE_JWT_SECRET)
FILES_SIGNING_SECRET=

# --- Экспорт уголовного дела в .docx ---
# Необязательно: путь к шаблону .docx (старый шаблон Google Docs: Файл → Скачать → .docx)
CCW_TEMPLATE_DOCX=
# Сколько дней действует ссылка на документ
CCW_LINK_DAYS=365

# --- Прокси ---
IMGUR_SOCKS5_PROXY=host:port:username:password
FORUM_HTTP_PROXY=host:port:username:password

# --- Удалённый парсер ---
PARSER_WORKER_URL=http://parser-worker:8765
PARSER_SECRET_KEY=CHANGE_ME_RANDOM_SECRET

# --- Учётные записи форумов (разделы закрыты за авторизацией) ---
# Без них parser-worker увидит login-wall → 0 ссылок → сработает защита БЗ, а судебка
# и разбор жалоб на этих форумах вернут пустой результат.
FORUM_MAJESTIC_LOGIN=YOUR_MAJESTIC_LOGIN
FORUM_MAJESTIC_PASSWORD=YOUR_MAJESTIC_PASSWORD
FORUM_RUSSIA_ONLINE_LOGIN=YOUR_RUSSIA_ONLINE_LOGIN
FORUM_RUSSIA_ONLINE_PASSWORD=YOUR_RUSSIA_ONLINE_PASSWORD
# Вместо логина и пароля можно дать cookie xf_user своего аккаунта (из браузера, как есть).
# Подходит для любого форума, в том числе gta5rp и nova-rp.
FORUM_GTA5RP_XF_USER=
FORUM_MAJESTIC_XF_USER=
FORUM_NOVA_XF_USER=
FORUM_RUSSIA_ONLINE_XF_USER=
FORUM_RMRP_XF_USER=

# --- Нагрузка на форумы (parser-worker) ---
# Пауза между страницами для каждого форума, 'host:секунды,...'. Каждый форум получает
# одну загрузку за раз. Пустое значение выключает паузы (форумы начнут блокировать IP).
# HOST_FETCH_DELAYS=forum.rmrp.ru:8,forum.majestic-rp.ru:4,forum.gta5rp.com:4,forum.russia.online:4,forum.nova-rp.com:4
# Автостоп: после N ошибок подряд (таймаут, 403, 429, 5xx) форум не опрашивается N секунд;
# если сразу после паузы снова ошибка, пауза удваивается до максимума.
# HOST_BREAKER_FAILS=3
# HOST_BREAKER_COOLDOWN_SECONDS=900
# HOST_BREAKER_MAX_COOLDOWN_SECONDS=7200
# Тема скачивается заново, если в ней новое сообщение или с прошлой проверки прошло
# около N дней (правки первого поста время последнего сообщения не меняют). 0 — каждый раз.
# LAW_FULL_RECHECK_DAYS=7

# --- API Сервер ---
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8000

# --- Секреты подписи (длинные случайные строки, например: openssl rand -hex 32) ---
# Без DEVICE_JWT_SECRET токены устройств подписываются случайным ключом процесса
# и не переживают рестарт, а веб-вход сайта выключен.
DEVICE_JWT_SECRET=
# Необязательно: отдельные секреты; по умолчанию берутся из DEVICE_JWT_SECRET.
WEB_SESSION_SECRET=
INTERNAL_API_SECRET=
KILL_SWITCH_INTERNAL_SECRET=

# --- Релей для пользователей из РФ (необязательно) ---
# IP релей-серверов через запятую (IPv4/IPv6). Вся когорта за релеем видна как один IP,
# поэтому лимит запросов для этих адресов умножается на OVERLAY_RELAY_RPM_MULT.
OVERLAY_RELAY_IPS=
OVERLAY_RELAY_RPM_MULT=10

# --- Локальный FRIDA-поиск законов ---
# Включать только когда pinned-модель разложена в ./models/frida на Docker-хосте.
# API использует её для query-вектора; dedicated worker достраивает корпус статей.
LAW_CATALOG_EMBED_ENABLED=false
LAW_CATALOG_EMBED_MODEL_DIR=/app/models/frida
# В compose значения для API/worker заданы раздельно. Этот default не даёт
# случайному API-процессу запустить второй consumer той же durable-очереди.
LAW_EMBED_RUN_WORKER=false
LAW_EMBED_WORKER_INTRA_THREADS=6
LAW_EMBED_WORKER_INFERENCE_CHUNK_SIZE=4
LAW_EMBED_WORKER_INIT_TIMEOUT_SECONDS=120
LAW_EMBED_JOB_CHUNK_TIMEOUT_SECONDS=120
LAW_EMBED_WORKER_HEARTBEAT_SECONDS=5
LAW_EMBED_WORKER_HEALTH_MAX_AGE_SECONDS=45
LAW_SEARCH_EMBED_TIMEOUT=2.0

# Журнал качества поиска: вопрос + компактный снимок реально показанной выдачи.
# Запись идёт через bounded-очередь и никогда не блокирует пользовательский запрос.
LAW_SEARCH_LOG_ENABLED=true
LAW_SEARCH_LOG_RETENTION_DAYS=90
LAW_SEARCH_LOG_QUEUE_SIZE=2048
LAW_SEARCH_LOG_BATCH_SIZE=50
LAW_SEARCH_LOG_FLUSH_SECONDS=1.0
LAW_SEARCH_LOG_DB_TIMEOUT=2.0
LAW_SEARCH_LOG_SHUTDOWN_TIMEOUT=3.0

# --- Администрирование ---
SUPER_ADMIN_ID=YOUR_TELEGRAM_USER_ID
